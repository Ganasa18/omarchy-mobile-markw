#!/bin/bash
# SPDX-License-Identifier: MIT
# Exercise the markw initramfs storage guard (RAM-only and microSD root) and
# the input checks of build-markw-probe, build-markw-sd and markw-kernel,
# without a phone, a block device, a card or Docker.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
bash -n tools/build-markw-probe
bash -n tools/build-markw-sd
bash -n tools/markw-kernel
bash -n device/markw/sd-image
sh -n device/markw/initramfs/init
sh -n device/markw/initramfs/build
python3 - <<'PY'
import os
from pathlib import Path
import subprocess
import tempfile

init = Path('device/markw/initramfs/init').read_text()
guard = init.split('ROOT_UUID=""\n', 1)[1].split('\nstorage_guard || exit 1', 1)[0]
guard = 'ROOT_UUID=""\n' + guard
# Exercise the real first-call failure path, before the background watcher,
# modules or USB start. Sleeping here would leave no recovery service.
first_pass = init.split(guard, 1)[1].split('\n(', 1)[0]
UUID = '0f1e2d3c-4b5a-6978-8796-a5b4c3d2e1f0'

with tempfile.TemporaryDirectory() as work:
    root = Path(work)
    sys, dev, bin, rw, etc = (root / n for n in ('sys', 'dev', 'bin', 'rw', 'etc'))
    for p in (sys, dev, bin, rw, etc):
        p.mkdir()
    (root / 'cmdline').write_text('console=tty0\n')
    # Preserve the real guard's logic; redirect only its absolute paths and
    # the block-device type check to inert temporary fixtures.
    body = guard.replace('/sys/class/block/', str(sys) + '/')
    body = body.replace('/run/omamobile-rw', str(rw))
    body = body.replace('/etc/omamobile-sd-root', str(etc / 'sd-root'))
    body = body.replace('/proc/cmdline', str(root / 'cmdline'))
    body = body.replace('"/dev/', '"' + str(dev) + '/').replace('[ -b ', '[ -f ')
    (root / 'guard.sh').write_text('say() { echo "$*" >&2; }\n' + body
                                   + '\nstorage_guard || exit 1\nstorage_unguarded\n')
    (root / 'startup.sh').write_text(
        'say() { echo "$*" >&2; }\nsleep() { exit 94; }\n' + body + first_pass
        + '\nexit 93\n')
    tools = {
        'blockdev': '#!/bin/sh\nset -eu\n[ "$1" = --setro ] || exit 92\nname=${2##*/}\n'
                    'echo "$name" >> "$CALLS"\n[ "${MODE:-ok}" != fail ] || exit 1\n'
                    '[ "${MODE:-ok}" != lie ] || exit 0\necho 1 > "$SYS/$name/ro"\n',
        # blkid -s UUID -o value DEV: the fixture's uuid file
        'blkid': '#!/bin/sh\ncat "$SYS/${5##*/}/uuid" 2>/dev/null\n',
    }
    for tool, script in tools.items():
        (bin / tool).write_text(script)
        (bin / tool).chmod(0o755)
    env = dict(os.environ, PATH=str(bin) + ':' + os.environ['PATH'],
               SYS=str(sys), CALLS=str(root / 'calls'))

    def device(name, ro='0', type=None, uuid=None):
        d = sys / name
        d.mkdir()
        (d / 'ro').write_text(ro + '\n')
        (dev / name).touch()
        if type:
            (d / 'device').mkdir()
            (d / 'device' / 'type').write_text(type + '\n')
        else:
            (d / 'partition').write_text('1\n')
        if uuid:
            (d / 'uuid').write_text(uuid + '\n')

    def run(mode='ok'):
        return subprocess.run(['sh', str(root / 'guard.sh')],
                              env=dict(env, MODE=mode), capture_output=True, text=True)

    def ro(name):
        return (sys / name / 'ro').read_text().strip()

    def all_ro():
        return all(p.read_text().strip() == '1' for p in sys.glob('*/ro'))

    def reset():
        for d in list(sys.iterdir()) + list(dev.iterdir()) + list(rw.iterdir()):
            subprocess.run(['rm', '-rf', str(d)], check=True)
        for f in (root / 'calls', etc / 'sd-root'):
            f.unlink(missing_ok=True)

    def layout():
        # The eMMC has a partition carrying the root UUID too: never writable
        device('mmcblk0', type='MMC')
        device('mmcblk0p1')
        device('mmcblk0p45', uuid=UUID)
        device('mmcblk0boot0', type='MMC')
        device('mmcblk0boot1', type='MMC')
        device('mmcblk1', type='SD')
        device('mmcblk1p1', uuid='11111111-2222-3333-4444-555555555555')
        device('mmcblk1p2', uuid=UUID)
        device('sda', type='SCSI')

    # M1: no root UUID, every disk read-only, SD card included.
    layout()
    assert run().returncode == 0
    assert all_ro()
    print('ok - without a root UUID the guard protects eMMC, boot0/boot1 and the microSD card')

    previous = (root / 'calls').read_text()
    assert run('fail').returncode == 0
    assert (root / 'calls').read_text() == previous
    print('ok - already read-only devices need no ioctl')

    device('mmcblk2', type='SD')
    assert run().returncode == 0
    assert ro('mmcblk2') == '1'
    print('ok - a later pass protects newly enumerated storage')

    (sys / 'mmcblk2/ro').write_text('0\n')
    assert run('fail').returncode != 0
    assert run('lie').returncode != 0
    print('ok - both ioctl failure and a missing read-only flag fail the guard')

    # M3: only the SD partition with the root UUID, and its disk, stay writable.
    reset()
    (etc / 'sd-root').write_text(UUID + '\n')
    layout()
    result = run()
    assert result.returncode == 0, result
    writable = {n.name for n in sys.iterdir() if ro(n.name) == '0'}
    assert writable == {'mmcblk1', 'mmcblk1p2'}, writable
    assert not (dev / 'mmcblk1').exists()
    assert result.stdout == '', result.stdout
    print('ok - with a root UUID only that microSD partition (and its disk, node removed) is writable')
    print('ok - an eMMC partition carrying the same UUID stays read-only')

    (sys / 'mmcblk0p1/ro').write_text('0\n')
    (dev / 'mmcblk0p1').unlink()
    result = run()
    assert result.stdout.split() == ['mmcblk0p1'], result
    print('ok - storage_unguarded reports a writable eMMC partition the guard could not reach')

    for bad in ('not-a-uuid', UUID.upper(), UUID + 'x'):
        reset()
        (etc / 'sd-root').write_text(bad + '\n')
        layout()
        assert run().returncode == 0
        assert all_ro(), bad
    print('ok - a malformed root UUID leaves every disk read-only')

    reset()
    (etc / 'sd-root').write_text(UUID + '\n')
    (root / 'cmdline').write_text('console=tty0 omamobile.initramfs\n')
    layout()
    assert run().returncode == 0
    assert all_ro()
    print('ok - omamobile.initramfs keeps every disk read-only')
    (root / 'cmdline').write_text('console=tty0\n')

    reset()
    device('mmcblk0', type='MMC')
    for mode in ('fail', 'lie'):
        result = subprocess.run(['sh', str(root / 'startup.sh')],
                                env=dict(env, MODE=mode), capture_output=True,
                                text=True, timeout=2)
        assert result.returncode == 1, result
    print('ok - initial guard failure exits PID 1 before services, without sleeping')
PY

# The builder must refuse bad input before it starts a container.
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
mkdir -p "$t/bin" "$t/modules"
# shellcheck disable=SC2016 # fake command reads the exported fixture path
printf '#!/bin/sh\necho called >> "$CALLS"\nexit 97\n' > "$t/bin/docker"
chmod +x "$t/bin/docker"
export PATH="$t/bin:$PATH" CALLS="$t/calls"
touch "$t/Image.gz" "$t/markw.dtb" "$t/mkbootimg.py"
ssh-keygen -q -t ed25519 -N '' -f "$t/key" >/dev/null
build() {
  tools/build-markw-probe --kernel "$t/Image.gz" --dtb "$t/markw.dtb" \
    --modules "$t/modules" --ssh-key "$1" --mkbootimg "$t/mkbootimg.py" \
    --out "$t/out" "${@:2}" 2>/dev/null
}
if build "$t/key.pub"; then
  echo 'not ok - accepts a modules directory without modules.order' >&2; exit 1
fi
touch "$t/modules/modules.order"
if build "$t/key"; then
  echo 'not ok - accepts a private SSH key' >&2; exit 1
fi
for uuid in not-a-uuid 0F1E2D3C-4B5A-6978-8796-A5B4C3D2E1F0 '0f1e2d3c-4b5a-6978-8796-a5b4c3d2e1f0;x'; do
  if build "$t/key.pub" --root-uuid "$uuid"; then
    echo "not ok - accepts --root-uuid $uuid" >&2; exit 1
  fi
done
[[ ! -e $t/calls ]] || { echo 'not ok - builder started a container on bad input' >&2; exit 1; }
echo 'ok - builder refuses missing modules, private keys and malformed root UUIDs before Docker'

# build-markw-sd: only a checked markw root image, before any container.
mkdir -p "$t/sd"
printf 'x' > "$t/sd/omamobile-rootfs-v-aarch64.img.zst"
(cd "$t/sd" && sha256sum omamobile-rootfs-v-aarch64.img.zst > omamobile-rootfs-v-aarch64.img.zst.sha256)
printf 'USERNAME=tester
PASSWORD_HASH=$6$a$b
' > "$t/sd/firstboot.conf"
sd() {
  tools/build-markw-sd --rootfs "$t/sd/omamobile-rootfs-v-aarch64.img.zst" --out "$t/sd/out"     --firstboot "$t/sd/firstboot.conf" --ssh-key "$t/key.pub" "$@" >/dev/null 2>&1
}
printf 'device: cheetah (omamobile-device-cheetah)
' > "$t/sd/omamobile-rootfs-v-aarch64.MANIFEST"
if sd; then echo 'not ok - build-markw-sd takes a cheetah root image' >&2; exit 1; fi
printf 'device: markw (omamobile-device-markw)
' > "$t/sd/omamobile-rootfs-v-aarch64.MANIFEST"
if sd --card-size 12X; then echo 'not ok - build-markw-sd takes a bad card size' >&2; exit 1; fi
printf 'y' >> "$t/sd/omamobile-rootfs-v-aarch64.img.zst"
if sd; then echo 'not ok - build-markw-sd takes an image that fails its checksum' >&2; exit 1; fi
if tools/build-markw-sd --rootfs "$t/sd/omamobile-rootfs-v-aarch64.img.zst" --out "$t/sd/out"      --firstboot "$t/sd/firstboot.conf" 2>/dev/null; then
  echo 'not ok - build-markw-sd takes --firstboot without --ssh-key' >&2; exit 1
fi
[[ ! -e $t/calls ]] || { echo 'not ok - build-markw-sd started a container on bad input' >&2; exit 1; }
echo 'ok - build-markw-sd refuses other devices, bad sizes, bad checksums and missing keys before Docker'

# markw-kernel: a pinned or explicitly checked package only.
if tools/markw-kernel --apk "$t/sd/firstboot.conf" --out "$t/k1" 2>/dev/null; then
  echo 'not ok - markw-kernel takes a package that is not the pinned one' >&2; exit 1
fi
if tools/markw-kernel --url https://example.invalid/k.apk --out "$t/k2" 2>/dev/null; then
  echo 'not ok - markw-kernel downloads an unpinned package without --sha256' >&2; exit 1
fi
if tools/markw-kernel --apk "$t/sd/firstboot.conf" --sha256 ABC --out "$t/k3" 2>/dev/null; then
  echo 'not ok - markw-kernel takes a malformed --sha256' >&2; exit 1
fi
echo 'ok - markw-kernel refuses unpinned or mismatched kernel packages'
