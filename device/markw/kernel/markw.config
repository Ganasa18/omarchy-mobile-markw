# SPDX-License-Identifier: MIT
# Redmi 4 Prime (markw): merged over postmarketOS's MSM8953 config by
# tools/build-markw-kernel. Each value is checked after olddefconfig.

# Our own release, installed beside postmarketOS's modules on the root.
CONFIG_LOCALVERSION="-msm8953-oma1"

# Turn a hang into a panic, so panic=10 reboots and pstore keeps the trace.
# The 2026-10-28 OTG freeze left nothing (BRINGUP-OTG.md).
CONFIG_SOFTLOCKUP_DETECTOR=y
# Panic after one soft-lockup period (20 s at the default watchdog_thresh).
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
# Hung tasks are only reported: a slow microSD can block a writer for long.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=0

# pacman 7 sandboxes its downloader with Landlock (already in CONFIG_LSM).
CONFIG_SECURITY_LANDLOCK=y

# USB-serial adapters for ESP32 and Arduino boards (BRINGUP-OTG.md).
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m

# Nothing on the phone reads the kernel's debug info, and it would make the
# build several gigabytes larger.
CONFIG_DEBUG_INFO_NONE=y
