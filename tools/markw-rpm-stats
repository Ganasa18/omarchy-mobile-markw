#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# Read-only: RPM sleep stats (vlow = XO shutdown, vmin = VDD min) and RPM
# master stats on msm8953, read from /dev/mem as mainline qcom_stats
# ("qcom,rpm-stats" at 0x290000) and the vendor kernel's rpm_master_stat.c
# (message RAM 0x60150, stride 4096, version 2) read them. Run on the phone
# as root: tools/phone-ssh 'python3 -' < tools/markw-rpm-stats
# This is device memory: aligned 32-bit reads only (wider or unaligned
# copies raise SIGBUS in the reading process).
import mmap, os, struct, time
fd = os.open("/dev/mem", os.O_RDONLY | os.O_SYNC)
m = mmap.mmap(fd, 4096, mmap.MAP_SHARED, mmap.PROT_READ, offset=0x290000)
rd = lambda a: struct.unpack("<I", m[a:a + 4])[0]
off = rd(0x14) & 0xffff
for i in range(2):
    b = off + i * 48
    w = [rd(b + 4 * k) for k in range(9)]          # aligned 32-bit reads only: device memory
    t, cnt, votes = w[0], w[1], w[8]
    ent, ext, acc = (w[2] | w[3] << 32), (w[4] | w[5] << 32), (w[6] | w[7] << 32)
    name = t.to_bytes(4, "little").decode("ascii", "replace").strip("\0 ")
    print(f"{name}: count={cnt} accumulated_s={acc / 19200000:.1f} last_entered={ent / 19200000:.1f} last_exited={ext / 19200000:.1f} votes={votes:#x}")
mm = mmap.mmap(fd, 0x6000, mmap.MAP_SHARED, mmap.PROT_READ, offset=0x60000)
mr = lambda a: struct.unpack("<I", mm[a:a + 4])[0]
for i, name in enumerate(["APSS", "MPSS", "PRONTO", "TZ", "LPASS"]):
    b = 0x150 + i * 4096
    xo = (mr(b + 0x48) | mr(b + 0x4c) << 32) / 19200000
    print(f"{name}: active_cores={mr(b):#x} numshutdowns={mr(b + 4)} xo_count={mr(b + 0x34)} xo_accumulated_s={xo:.1f}")
print("boottime", round(time.clock_gettime(time.CLOCK_BOOTTIME), 1))
