#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Guarded markw watchdog feeder for an explicitly approved safety gate."""
import argparse
from array import array
import gzip
import os
from pathlib import Path
import signal
import struct
import sys
import time

try:
    import fcntl
except ImportError:  # Permit host unit tests with mocked Linux syscalls.
    fcntl = None

GETSUPPORT = 0x80285700
SETOPTIONS = 0x80045704
KEEPALIVE = 0x80045705
GETTIMEOUT = 0x80045707
MAGICCLOSE = 0x100
DISABLECARD = 1
PIDFILE = Path("/run/markw-suspend-wd.pid")


def preflight():
    driver = Path("/sys/class/watchdog/watchdog0/device/driver").resolve(strict=True)
    if driver.name != "qcom_wdt":
        raise RuntimeError("watchdog0 is not bound to qcom_wdt")
    with gzip.open("/proc/config.gz", "rt") as stream:
        config = stream.read().splitlines()
    if "# CONFIG_WATCHDOG_NOWAYOUT is not set" not in config:
        raise RuntimeError("nowayout is not confirmed off; refusing to open watchdog")


class Watchdog:
    def __init__(self, device="/dev/watchdog0"):
        self.device = device
        self.fd = None

    def __enter__(self):
        self.fd = os.open(self.device, os.O_WRONLY | os.O_CLOEXEC)
        try:
            info = bytearray(40)
            fcntl.ioctl(self.fd, GETSUPPORT, info, True)
            options, _, identity = struct.unpack("=II32s", info)
            self.identity = identity.split(b"\0", 1)[0].decode("ascii")
            timeout = array("i", [0])
            fcntl.ioctl(self.fd, GETTIMEOUT, timeout, True)
            self.timeout = timeout[0]
            if self.identity != "qcom_wdt" or not options & MAGICCLOSE:
                raise RuntimeError("unexpected watchdog identity or no magic-close support")
            if self.timeout < 30:
                raise RuntimeError("watchdog timeout below 30 seconds")
            return self
        except BaseException:
            self.close()
            raise

    def ping(self):
        fcntl.ioctl(self.fd, KEEPALIVE, 0)

    def close(self):
        if self.fd is None:
            return
        fd, self.fd = self.fd, None
        try:
            # An explicit successful disable confirms disarm without SYSFS.
            fcntl.ioctl(fd, SETOPTIONS, array("i", [DISABLECARD]), True)
        finally:
            try:
                os.write(fd, b"V")
            finally:
                os.close(fd)

    def __exit__(self, *args):
        self.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="read-only driver/config preflight")
    parser.add_argument("--seconds", type=int, default=300)
    args = parser.parse_args()
    if not 5 <= args.seconds <= 300:
        parser.error("seconds must be between 5 and 300")
    if fcntl is None:
        raise RuntimeError("Linux fcntl is required")
    preflight()
    if args.check:
        print("PREFLIGHT: qcom_wdt binding confirmed; nowayout disabled; device not opened")
        return

    stopping = False

    def stop(signum, frame):
        nonlocal stopping
        stopping = True

    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, stop)
    pidfile = PIDFILE
    owner = str(os.getpid())
    with pidfile.open("x") as stream:
        stream.write(owner)
    try:
        clock = lambda: time.clock_gettime(time.CLOCK_BOOTTIME)
        with Watchdog() as watchdog:
            watchdog.ping()
            print(f"ARMED: {watchdog.identity}, timeout={watchdog.timeout}s", flush=True)
            deadline = clock() + args.seconds
            while not stopping and clock() < deadline:
                time.sleep(2)
                if not stopping:
                    watchdog.ping()
    finally:
        try:
            if pidfile.read_text() == owner:
                pidfile.unlink()
        except FileNotFoundError:
            pass
    print("DISARMED: disable ioctl succeeded, magic close completed", flush=True)


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"STOP: {error}", file=sys.stderr, flush=True)
        sys.exit(1)
