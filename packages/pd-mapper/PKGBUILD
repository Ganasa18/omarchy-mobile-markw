# SPDX-License-Identifier: 0BSD
#
# Omarchy Mobile build of pd-mapper, the Qualcomm protection-domain mapper a
# modem asks over QRTR before it starts its services, for the Redmi 4
# Prime's mobile data (device/markw/BRINGUP-MODEM.md). Arch Linux ARM
# doesn't package it, and the markw kernel doesn't set the in-kernel
# QCOM_PD_MAPPER. A plain build of the upstream release. Choices:
#  - compiled with cc directly (five files), so the phone builds it without
#    make;
#  - pd-mapper.service is installed but not enabled.

pkgname=pd-mapper
pkgver=1.1
pkgrel=1
pkgdesc='Qualcomm protection domain mapper'
arch=(aarch64)
url='https://github.com/linux-msm/pd-mapper'
license=(BSD-3-Clause)
depends=(glibc qrtr-git xz)
source=("$pkgname-$pkgver.tar.gz::https://github.com/linux-msm/pd-mapper/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7654a7fb8b70b0c7670f98ad9313649abc48eabcef84dad086ed01408fd538a2')

build() {
  cd "$pkgname-$pkgver"
  ${CC:-cc} $CPPFLAGS $CFLAGS -o pd-mapper \
    pd-mapper.c assoc.c json.c servreg_loc.c lzma_decomp.c \
    $LDFLAGS -lqrtr -llzma
  sed 's+PD_MAPPER_PATH+/usr/bin+g' pd-mapper.service.in >pd-mapper.service
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 pd-mapper "$pkgdir/usr/bin/pd-mapper"
  install -Dm644 pd-mapper.service "$pkgdir/usr/lib/systemd/system/pd-mapper.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
