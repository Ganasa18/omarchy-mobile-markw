# SPDX-License-Identifier: 0BSD
#
# Omarchy Mobile build of ModemManager for IPA modems (markw, msm8953).
#
# Derived from Arch Linux's modemmanager PKGBUILD, 1.24.2-2
# (https://gitlab.archlinux.org/archlinux/packaging/packages/modemmanager at
# 92daa21), which Arch Linux ARM builds unchanged. Omarchy Mobile changes:
#  - 0001-base-manager-fix-cleanup-of-multiplexed-bearers.patch: upstream
#    0edcb916ad2b (Daniele Palmas, 2025-10-03), in 1.25.x but not on
#    mm-1-24. On suspend, 1.24.2 counts active bearers against
#    MaxActiveBearers alone, which is 0 on IPA (only multiplexed bearers),
#    so suspending with mobile data up aborts ModemManager
#    (device/markw/BRINGUP-MODEM.md). Drop it once Arch ships 1.26.
#  - pkgrel 2.1, so it sorts above Arch's 1.24.2-2; [omamobile] comes first
#    in pacman.conf, so pacman takes this build either way.
#  - arch=(aarch64); no gtk-doc and no modemmanager-docs package (an hour of
#    doc build on the phone for files nobody reads there).
#  - The tag is pinned by Arch's b2sum of the tree instead of its PGP
#    signature, so the build needs no keys imported into the builder's
#    keyring; the tree is the same.
#  - meson compile takes its job count from MAKEFLAGS (default 4), as the
#    hyprland package does, so the phone doesn't run out of memory.
#
# Maintainer of the original: Jan Alexander Steffens (heftig); contributor
# Ionut Biru.

pkgbase=modemmanager
pkgname=(
  modemmanager
  libmm-glib
)
pkgver=1.24.2
pkgrel=2.1
pkgdesc="Mobile broadband modem management service (Omarchy Mobile: IPA suspend fix)"
url="https://www.freedesktop.org/wiki/Software/ModemManager/"
arch=(aarch64)
license=(
  GPL-2.0-or-later
  LGPL-2.1-or-later
)
depends=(
  bash
  glib2
  glibc
  hicolor-icon-theme
  libgcc
  libgudev
  libmbim
  libqmi
  libqrtr-glib
  mobile-broadband-provider-info
  polkit
  ppp
  systemd-libs
)
makedepends=(
  bash-completion
  git
  glib2-devel
  gobject-introspection
  meson
  systemd
  vala
)
source=(
  "git+https://gitlab.freedesktop.org/mobile-broadband/ModemManager.git#tag=${pkgver/[a-z]/-&}"
  0001-base-manager-fix-cleanup-of-multiplexed-bearers.patch
)
b2sums=('fbf202dc30af2201ba2a675183bdf8b12d0f8665e4a73454c7d7bca8cc7acf4ee93c42c291f9ddfa84c696b7c05a1b68e4211f7e75707aea0000f77bff6cc72b'
        'cad28a0df7458b477a8a449e83c252814953a3fc565ab74851bfbcfd9fcb8e5b14dbd3c559c5cd3c39aa89f2de20b9a8832d2d0462cdb583a68d628b0250febc')

prepare() {
  cd ModemManager

  # Fix for Fibocom modems (Arch's)
  # https://gitlab.archlinux.org/archlinux/packaging/packages/modemmanager/-/issues/1
  git cherry-pick -n 018e44084825ab294ad2b5d5b301d2b9e2577eb1

  # Omarchy Mobile: suspend with a multiplexed bearer up (upstream 0edcb916ad2b)
  git apply "$srcdir/0001-base-manager-fix-cleanup-of-multiplexed-bearers.patch"
}

build() {
  local meson_options=(
    -D dbus_policy_dir=/usr/share/dbus-1/system.d
    -D dist_version="\"$pkgver-$pkgrel\""
    -D gtk_doc=false
    -D polkit=permissive
    -D vapi=true
  )
  local jobs
  jobs=$(sed -n 's/.*-j *\([0-9]\+\).*/\1/p' <<<"${MAKEFLAGS:-}")

  arch-meson ModemManager build "${meson_options[@]}"
  meson compile -C build -j "${jobs:-4}"
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_modemmanager() {
  license=(GPL-2.0-or-later)
  depends+=(
    "libmm-glib=$pkgver-$pkgrel" libmm-glib.so
    libgudev-1.0.so
    libg{lib,object,io,module}-2.0.so
    libmbim-glib.so
    libqmi-glib.so
    libsystemd.so
  )
  optdepends=(
    'usb_modeswitch: install if your modem shows up as a storage drive'
  )

  meson install -C build --destdir "$pkgdir"

  cd "$pkgdir"
  _pick libmm usr/include
  _pick libmm usr/lib/girepository-1.0
  _pick libmm usr/lib/libmm-glib.so*
  _pick libmm usr/lib/pkgconfig
  _pick libmm usr/share/gir-1.0
  _pick libmm usr/share/vala
}

package_libmm-glib() {
  pkgdesc="ModemManager library"
  license=(LGPL-2.1-or-later)
  depends=(
    glib2 libg{lib,object,io}-2.0.so
    glibc
    libgcc
  )
  provides=(libmm-glib.so)

  mv libmm/* "$pkgdir"
}

