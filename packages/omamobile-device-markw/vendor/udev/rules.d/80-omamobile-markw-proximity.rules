# SPDX-License-Identifier: MIT
# The LTR-559's proximity channel reads 19-32 uncovered and 58-237 with a
# finger over it (device/markw/NOTES.md, 2026-11-02). iio-sensor-proxy calls
# a reading at or above PROXIMITY_NEAR_LEVEL "near" and, without the
# property, offers no proximity at all.
ACTION=="add|change", SUBSYSTEM=="iio", KERNEL=="iio:device*", ATTR{name}=="ltr559", ENV{PROXIMITY_NEAR_LEVEL}="50"
