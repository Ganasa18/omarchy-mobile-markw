# SPDX-License-Identifier: MIT
# Suspend to idle once the screen has been off for AUTO_SUSPEND_DELAY
# seconds (device.conf). Enabled by the package from 0.1.28, after the
# overnight data-on soak (device/markw/BRINGUP-SUSPEND.md, CE).
# To turn it off: systemctl mask --now omamobile-autosuspend
[Unit]
Description=Omarchy Mobile: suspend when the screen has been off for a while
After=systemd-logind.service

[Service]
ExecStart=/usr/lib/omamobile/omamobile-autosuspend
Restart=on-failure
RestartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
