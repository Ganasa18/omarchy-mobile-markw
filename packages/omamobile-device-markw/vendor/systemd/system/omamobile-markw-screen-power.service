# SPDX-License-Identifier: MIT
# Fewer CPUs and a lower clock while the screen is off (SCREEN_OFF_* in
# device.conf). Shipped disabled until CPU hotplug is proven on markw; then:
#   systemctl enable --now omamobile-markw-screen-power
# Stopping it brings every CPU back.
[Unit]
Description=Omarchy Mobile: fewer CPUs and a lower clock while the screen is off

[Service]
ExecStart=/usr/lib/omamobile/omamobile-markw-screen-power
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
