# SPDX-License-Identifier: MIT
# Omarchy Mobile: USB networking to the host. The initramfs sets up the USB
# gadget (CDC NCM) before handing over to Arch; this gives it an address.
# A host that shares its internet over this link (NetworkManager "shared"
# mode on 172.16.42.2) is also the gateway, but only as a fallback: a
# Windows host shares nothing, and at metric 0 this route beat Wi-Fi's
# (NetworkManager uses 600), so Wi-Fi connected with no internet.
# DNS goes to public resolvers.
[Match]
Name=usb0

[Network]
Address=172.16.42.1/24
DNS=1.1.1.1
DNS=9.9.9.9
ConfigureWithoutCarrier=yes

[Route]
Gateway=172.16.42.2
Metric=1000
