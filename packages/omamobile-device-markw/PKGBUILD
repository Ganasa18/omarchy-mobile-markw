pkgname=omamobile-device-markw
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omarchy Mobile support for the Xiaomi Redmi 4 Prime (markw): storage guard, USB networking, zram swap and its own firmware copied from its partitions"
arch=(aarch64)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
depends=(bash systemd omamobile-keyring)
provides=(omamobile-device)
conflicts=(omamobile-device)
backup=(etc/pacman.d/omamobile-mirrorlist etc/NetworkManager/conf.d/zz-omamobile-wifi-powersave.conf)
install=omamobile-device-markw.install
makedepends=(gcc)

build() {
  "$startdir/build" "$srcdir/build"
}

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir" "$srcdir/build"
}
