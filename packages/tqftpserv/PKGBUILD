# SPDX-License-Identifier: 0BSD
#
# Omarchy Mobile build of tqftpserv, the TFTP server a Qualcomm modem asks
# for its files over QRTR, for the Redmi 4 Prime's mobile data
# (device/markw/BRINGUP-MODEM.md). Arch Linux ARM doesn't package it. A plain
# build of the upstream release. Choices:
#  - compiled with cc directly (the sources are four files), so the phone
#    builds it without make or meson;
#  - xz and zstd decompression on, as upstream's meson build does when the
#    libraries are there;
#  - tqftpserv.service is installed but not enabled; upstream's
#    populate-readwrite helper (it mounts persist by partition label) is
#    left out.

pkgname=tqftpserv
pkgver=1.3
pkgrel=1
pkgdesc='TFTP server for Qualcomm modems over QRTR'
arch=(aarch64)
url='https://github.com/linux-msm/tqftpserv'
license=(BSD-3-Clause)
depends=(glibc qrtr-git xz zstd)
source=("$pkgname-$pkgver.tar.gz::https://github.com/linux-msm/tqftpserv/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('87a3845e8f47b42f31d8aaad04c5e0707e391b3954d096aeff6f0a03467dc33f')

build() {
  cd "$pkgname-$pkgver"
  ${CC:-cc} $CPPFLAGS $CFLAGS -DHAVE_XZ -DHAVE_ZSTD -o tqftpserv \
    tqftpserv.c translate.c xz-decompress.c zstd-decompress.c \
    $LDFLAGS -lqrtr -llzma -lzstd
  sed 's+@prefix@+/usr+g' tqftpserv.service.in >tqftpserv.service
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 tqftpserv "$pkgdir/usr/bin/tqftpserv"
  install -Dm644 tqftpserv.service "$pkgdir/usr/lib/systemd/system/tqftpserv.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
