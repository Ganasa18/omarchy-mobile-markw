# Power-only phones: input/idle activity may refresh a lit lock but cannot
# light a dark panel. Power uses a distinct trusted IPC path. Never disable
# the compositor touchscreen device. Serialize blank/wake and its state check.
# Against Omarchy 4.0.6, after patches 0008, 0009 and 0013.
diff --git i/bin/omarchy-brightness-display w/bin/omarchy-brightness-display
--- i/bin/omarchy-brightness-display
+++ w/bin/omarchy-brightness-display
@@ -70,11 +70,31 @@
 
 step="$1"
 
+# Keep the input-wake check and the panel transition atomic against blanking.
+exec {lock_fd}>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-display.lock"
+if [[ $step == off || $step == on ]]; then
+  flock "$lock_fd" || exit 1
+else
+  flock -n "$lock_fd" || exit 0
+fi
+
 if [[ $step == "off" ]]; then
   hyprctl dispatch 'hl.dsp.dpms({ action = "disable" })' >/dev/null 2>&1
   panel_power 4
   exit 0
 elif [[ $step == "on" ]]; then
+  # Activity cannot light a Power-only phone. Explicit Power wake does not
+  # carry this flag. Never disable the touchscreen device to enforce it.
+  if [[ ${OMAMOBILE_WAKE_FROM_INPUT:-0} == 1 ]] &&
+     grep -qx 'POWER_KEY_WAKE_ONLY=1' "${OMAMOBILE_DEVICE_CONF:-/usr/share/omamobile/device.conf}" 2>/dev/null; then
+    device="$(omarchy-hw-display 2>/dev/null)" || exit 0
+    bl="${OMARCHY_BACKLIGHT_PATH:-/sys/class/backlight}/$device/bl_power"
+    read -r power <"$bl" 2>/dev/null || exit 0
+    [[ $power == 0 ]] || exit 0
+    # bl_power can be restored independently on resume. DPMS must also be
+    # lit: neither indicator alone authorizes activity to light the display.
+    hyprctl monitors -j 2>/dev/null | jq -e '[.[] | select(.disabled == false)] | length > 0 and all(.dpmsStatus)' >/dev/null 2>&1 || exit 0
+  fi
   # Before the check below: Hyprland can show a lit display whose panel is off.
   panel_power 0
   # Skip the dispatch when every active display is already lit: a redundant
@@ -84,11 +104,6 @@
   hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1
   exit 0
 fi
-
-# Drop overlapping brightness key events so concurrent invocations do not race.
-# Hardware key repeat present on some devices can otherwise glitch OSD rendering.
-exec {lock_fd}>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-display.lock"
-flock -n "$lock_fd" || exit 0
 
 if use_apple_display; then
   if (( no_osd )); then
