pkgname=omamobile-flash
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omarchy Mobile Flash: build, upload and watch PlatformIO projects (ESP32, Arduino) from a phone window"
arch=(any)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
depends=(bash quickshell platformio-core platformio-core-udev python-pyserial systemd)

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir"
}
